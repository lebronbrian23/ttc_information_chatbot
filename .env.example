For Reference Purposes

# 0.5 default. Set to 0.40 for higher recall (recommended for commuter-facing alerts)
TTC_DELAY_THRESHOLD=

# Pin a specific classification model version e.g. v20260307_055529. Leave empty to use latest active.
TTC_CLF_VERSION=

# Pin a specific regression model version e.g. v20260307_065006. Leave empty to use latest active.
TTC_REG_VERSION=

# Override path to route_stats.csv if not at default location. Leave empty in most cases.
TTC_LOOKUP_PATH=

# HMAC secret for signing webhook payloads. Set the same value on all subscriber services.
TTC_WEBHOOK_SECRET=

# ML service base URL. Use localhost for development, deployed URL for production.
ML_SERVICE_URL=http://localhost:8000
