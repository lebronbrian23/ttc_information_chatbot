# Local development environment for TTC Information Chatbot
# App runtime
PORT=8000
DEBUG=true
ML_THRESHOLD=0.5

# Database (SQLite local file)
# DATABASE_URL=sqlite:///./ttc_chatbot.db
DATABASE_URL=mysql+pymysql://root@localhost:3306/ttc_chatbot

# Auth / JWT (local only)
SECRET_KEY=local-dev-secret-key-change-this-if-shared
ADMIN_SETUP_KEY=change-me-in-production

# Default admin bootstrap values for backend/admin_setup.py
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ttc-chatbot.local
ADMIN_PASSWORD=changeme

# ML service behavior

# 0.5 default. Set to 0.40 for higher recall (recommended for commuter-facing alerts)
TTC_DELAY_THRESHOLD=

# Pin a specific classification model version e.g. v20260307_055529. Leave empty to use latest active.
TTC_CLF_VERSION=

# Pin a specific regression model version e.g. v20260307_065006. Leave empty to use latest active.
TTC_REG_VERSION=

# Override path to route_stats.csv if not at default location. Leave empty in most cases.
TTC_LOOKUP_PATH=

# HMAC secret for signing webhook payloads. Set the same value on all subscriber services.
TTC_WEBHOOK_SECRET=

# ML service base URL. Use localhost for development, deployed URL for production.
ML_SERVICE_URL=http://localhost:8000
